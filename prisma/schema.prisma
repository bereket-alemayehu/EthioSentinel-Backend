generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CITIZEN
  HEW
  ADMIN
  RESEARCHER
}

enum Language {
  AMHARIC
  ENGLISH
}

enum ReportSource {
  WEB
  PWA_OFFLINE
  PWA_ONLINE
  API
  IMPORT
}

enum ReportStatus {
  PENDING
  VERIFIED
  FLAGGED
  REJECTED
  SYNCED
}

enum AdvisoryStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertChannel {
  WEB
  EMAIL
}

model Region {
  id              Int        @id @default(autoincrement())
  name            String     @unique
  code            String     @unique
  primaryLanguage Language   @default(AMHARIC)
  districts       District[]
  advisories      Advisory[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model District {
  id         Int             @id @default(autoincrement())
  regionId   Int
  name       String
  code       String          @unique
  latitude   Decimal?        @db.Decimal(9, 6)
  longitude  Decimal?        @db.Decimal(9, 6)
  region     Region          @relation(fields: [regionId], references: [id], onDelete: Cascade)
  advisories Advisory[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([regionId, name])
  @@index([regionId])
}

model User {
  id               String          @id @default(uuid())
  username         String
  email            String          @unique
  passwordHash     String
  phoneNumber      String?         @unique
  role             Role
  isActive         Boolean         @default(true)
  region           String
  assignedDistrict String?
  clearanceLevel   Int?
  submittedReports   DiseaseReport[] @relation("ReportSubmittedBy")
  approvedAdvisories Advisory[]      @relation("AdvisoryApprovedBy")
  createdAlerts      Alert[]         @relation("AlertCreatedBy")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([role])
}

model Disease {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  slug           String          @unique
  description    String?
  symptomProfile String?
  isActive       Boolean         @default(true)
  alerts         Alert[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model DiseaseReport {
  id                  String         @id @default(uuid())
  district            String
  diseaseType         String
  reporterId          String
  timestamp           DateTime       @default(now())
  caseCount           Int            @default(0)
  deathCount          Int            @default(0)
  isOfflineCached     Boolean        @default(false)
  status              ReportStatus   @default(PENDING)
  isMortalityPriority Boolean        @default(false)
  notes               String?
  reporter            User           @relation("ReportSubmittedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  advisories          Advisory[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([district, timestamp])
  @@index([diseaseType, timestamp])
  @@index([status])
}

model Advisory {
  id              String         @id @default(uuid())
  diseaseType     String
  regionId        Int
  districtId      Int?
  sourceReportId  String?
  approvedById    String?
  title           String
  content         String
  language        String
  status          AdvisoryStatus @default(DRAFT)
  riskLevel       String         @default("MODERATE")
  generatedByAI   Boolean        @default(true)
  approvedAt      DateTime?
  region          Region         @relation(fields: [regionId], references: [id], onDelete: Cascade)
  district        District?      @relation(fields: [districtId], references: [id], onDelete: SetNull)
  sourceReport    DiseaseReport? @relation(fields: [sourceReportId], references: [id], onDelete: SetNull)
  approvedBy      User?          @relation("AdvisoryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  alerts          Alert[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([regionId])
  @@index([districtId])
  @@index([status])
}

model Alert {
  id            String        @id @default(uuid())
  targetZone    String
  diseaseId     Int?
  advisoryId    String?
  sourceReportId String?
  aiSuggested   Boolean       @default(false)
  createdById   String?
  title         String
  message       String
  severity      String
  channel       String
  isDelivered   Boolean       @default(false)
  deliveryCount Int           @default(0)
  failedCount   Int           @default(0)
  disease       Disease?      @relation(fields: [diseaseId], references: [id], onDelete: SetNull)
  advisory      Advisory?     @relation(fields: [advisoryId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("AlertCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([targetZone])
  @@index([severity])
  @@index([channel])
  @@index([aiSuggested])
  @@index([sourceReportId])
}