generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CITIZEN
  HEW
  ADMIN
  RESEARCHER
  SUPER_ADMIN
}

enum Language {
  AMHARIC
  ENGLISH
}

enum ReportSource {
  WEB
  PWA_OFFLINE
  PWA_ONLINE
  API
  IMPORT
}

enum ReportStatus {
  PENDING
  VERIFIED
  FLAGGED
  REJECTED
  SYNCED
}

enum AdvisoryStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertChannel {
  WEB
  EMAIL
}

enum ChatRole {
  USER
  ASSISTANT
}

enum AnomalyMethod {
  ZSCORE
  ARIMA
}

enum AnomalyClassification {
  NORMAL
  ANOMALY
}

model Region {
  id              Int        @id @default(autoincrement())
  name            String     @unique
  code            String     @unique
  primaryLanguage Language   @default(AMHARIC)
  districts       District[]
  advisories      Advisory[]
  healthFacilities HealthFacility[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model District {
  id         Int             @id @default(autoincrement())
  regionId   Int
  name       String
  code       String          @unique
  latitude   Decimal?        @db.Decimal(9, 6)
  longitude  Decimal?        @db.Decimal(9, 6)
  region     Region          @relation(fields: [regionId], references: [id], onDelete: Cascade)
  advisories Advisory[]
  healthFacilities HealthFacility[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([regionId, name])
  @@index([regionId])
}

model User {
  id               String          @id @default(uuid())
  username         String
  email            String?         @unique
  passwordHash     String
  phoneNumber      String?         @unique
  role             Role
  isActive         Boolean         @default(true)
  region           String?
  assignedDistrict String?
  healthFacilityId Int?            @unique
  clearanceLevel   Int?
  otpCode              String?
  otpExpiresAt         DateTime?
  /** Last channel used for OTP: "email" | "sms" (registration / password reset). */
  otpPreferredChannel  String?
  tokenVersion     Int             @default(0)
  submittedReports   DiseaseReport[] @relation("ReportSubmittedBy")
  approvedAdvisories Advisory[]      @relation("AdvisoryApprovedBy")
  createdAlerts      Alert[]         @relation("AlertCreatedBy")
  chatConversations  ChatConversation[]
  auditLogs          AuditLog[]      @relation("AuditActor")
  ownedFacilities    HealthFacility[]
  healthFacility     HealthFacility? @relation("UserHealthFacility", fields: [healthFacilityId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([role])
}

model AuditLog {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  actorUserId  String?
  actorEmail   String?
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
}

model ChatConversation {
  id        String        @id @default(uuid())
  userId    String
  title     String?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  role           ChatRole
  content        String
  language       String           @default("ENGLISH")
  modelProvider  String?
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model Disease {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  slug           String          @unique
  code           String          @unique
  description    String?
  symptomProfile String?
  isActive       Boolean         @default(true)
  alerts         Alert[]
  reports        DiseaseReport[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model DiseaseReport {
  id                  String         @id @default(uuid())
  district            String
  diseaseType         String
  diseaseId           Int?
  reporterId          String
  timestamp           DateTime       @default(now())
  caseCount           Int            @default(0)
  deathCount          Int            @default(0)
  isOfflineCached     Boolean        @default(false)
  status              ReportStatus   @default(PENDING)
  isMortalityPriority Boolean        @default(false)
  notes               String?
  disease             Disease?       @relation(fields: [diseaseId], references: [id], onDelete: SetNull)
  reporter            User           @relation("ReportSubmittedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  healthFacilityId    Int?
  healthFacility      HealthFacility? @relation(fields: [healthFacilityId], references: [id], onDelete: SetNull)
  advisories          Advisory[]
  anomalySignals      AnomalySignal[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([district, timestamp])
  @@index([diseaseType, timestamp])
  @@index([status])
  @@index([healthFacilityId])
}

model AnomalySignal {
  id              String                @id @default(uuid())
  reportId        String?
  district        String
  diseaseType     String
  currentCases    Float
  historicalMean  Float
  stdDev          Float
  zScore          Float?
  classification  AnomalyClassification @default(NORMAL)
  method          AnomalyMethod         @default(ZSCORE)
  sampleSize      Int                   @default(0)
  lookbackStart   DateTime?
  lookbackEnd     DateTime?
  advisoryId      String?
  alertId         String?
  manual          Boolean               @default(false)
  notes           String?
  report          DiseaseReport?        @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())

  @@index([district, diseaseType, createdAt])
  @@index([classification])
  @@index([reportId])
}

model Advisory {
  id              String         @id @default(uuid())
  diseaseType     String
  regionId        Int
  districtId      Int?
  sourceReportId  String?
  approvedById    String?
  title           String
  content         String
  language        String
  status          AdvisoryStatus @default(DRAFT)
  riskLevel       String         @default("MODERATE")
  generatedByAI   Boolean        @default(true)
  approvedAt      DateTime?
  region          Region         @relation(fields: [regionId], references: [id], onDelete: Cascade)
  district        District?      @relation(fields: [districtId], references: [id], onDelete: SetNull)
  sourceReport    DiseaseReport? @relation(fields: [sourceReportId], references: [id], onDelete: SetNull)
  approvedBy      User?          @relation("AdvisoryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  alerts          Alert[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([regionId])
  @@index([districtId])
  @@index([status])
}

model Alert {
  id            String        @id @default(uuid())
  targetZone    String
  diseaseId     Int?
  advisoryId    String?
  sourceReportId String?
  aiSuggested   Boolean       @default(false)
  createdById   String?
  title         String
  message       String
  severity      String
  channel       String
  isDelivered   Boolean       @default(false)
  deliveryCount Int           @default(0)
  failedCount   Int           @default(0)
  disease       Disease?      @relation(fields: [diseaseId], references: [id], onDelete: SetNull)
  advisory      Advisory?     @relation(fields: [advisoryId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("AlertCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([targetZone])
  @@index([severity])
  @@index([channel])
  @@index([aiSuggested])
  @@index([sourceReportId])
}
model HealthFacility {
  id         Int      @id @default(autoincrement())
  regionId   Int?    
  districtId Int?
  ownerId    String? // references User.id

  Region     String
  Zone       String
  Woreda     String
  HF_Name    String
  HF_Type    String
  Y          Decimal? @db.Decimal(9, 6)
  X          Decimal? @db.Decimal(9, 6)
  X1         Float?
  N          Float?
  E          Float?
  Z          Float?
  owner      String? // legacy owner string
  Status     String?

  region     Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  district   District?@relation(fields: [districtId], references: [id], onDelete: SetNull)
  ownerUser  User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  assignedUser User?  @relation("UserHealthFacility")
  reports      DiseaseReport[]

  @@index([regionId])
  @@index([districtId])
  @@unique([districtId, HF_Name], name: "unique_district_hfname")
}