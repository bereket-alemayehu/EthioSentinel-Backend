NODE_ENV=development
PORT=5001
DATABASE_URL=postgresql://postgres:password@localhost:5432/ETHIO_HEALTH_SENTINEL
JWT_SECRET=change-me
JWT_ACCESS_SECRET=change-me-access
FRONTEND_URL=http://localhost:5173
# From https://www.google.com/recaptcha/admin — reCAPTCHA v2 "I'm not a robot" (same widget for both lines)
RECAPTCHA_SITE_KEY=
SITESECRET=
# Set true only to use Google's test secret (matches test site key; red "testing" banner)
# RECAPTCHA_ALLOW_TEST=false
# Comma-separated emails for AI/alert notifications (in addition to ADMIN users)
ALERT_EMAIL_RECIPIENTS=
# Local dev: log emails to console instead of Brevo (use when IP is not whitelisted)
EMAIL_DEV_LOG_ONLY=false
# Gemini API key for chat + advisory drafts (free tier ~20 requests/day per model)
GEMINI_API_KEY=
